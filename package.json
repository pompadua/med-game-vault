{
  "name": "med-game-vault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "คลังเกมการเรียนแพทย์ + ระบบทวน FSRS",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run build:index && vite",
    "build": "npm run build:index && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate.ts",
    "build:index": "tsx scripts/build-index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "tsx scripts/clean.ts",
    "check": "npm run validate && npm test && npm run build",
    "pack:new": "tsx scripts/new-pack.ts",
    "vault:report": "tsx scripts/vault-report.ts",
    "debrief:summary": "tsx scripts/debrief-summary.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "deploy": "tsx scripts/deploy.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
